msgstr "Article language"

msgid "Tarte aux pommes normande\nPâte brisée, pommes, crème, calvados…\n\n---\n\nPoulet yassa\nPoulet, oignons, citron…"
msgstr "Normandy apple tart\nShortcrust, apples, cream, calvados…\n\n---\n\nChicken yassa\nChicken, onions, lemon…"
