msgstr "اختيار صور من حاسوبي"

#, php-format
msgid "JPEG, PNG ou WebP, %1$d au plus, %2$s Mo chacune."
msgstr "JPEG أو PNG أو WebP، %1$d كحد أقصى، %2$s ميغابايت لكل صورة."

