msgid_plural "%d éléments conservés"
msgstr[0] "لا عناصر محفوظة"
msgstr[1] "عنصر واحد محفوظ"
msgstr[2] "عنصران محفوظان"
msgstr[3] "%d عناصر محفوظة"
msgstr[4] "%d عنصرًا محفوظًا"
msgstr[5] "%d عنصر محفوظ"

msgid "Afficher aussi les essais, consignes et appels"
msgstr "إظهار المحاولات والتعليمات والاستدعاءات أيضًا"

msgid "Dont %s pour lire et apparier les photographies des lots."
msgstr "منها %s لقراءة صور الدفعات ومطابقتها."

msgid "Hors appels détaillés : lecture des photographies citées par la recherche, appariement des photographies des lots"
msgstr "خارج الاستدعاءات المفصَّلة: قراءة الصور التي يستشهد بها البحث، ومطابقة صور الدفعات"

msgid "dépensé"
msgstr "المُنفَق"

#. translators: 1: whole hours, 2: remaining minutes.
msgid "%1$d h %2$d min"
msgstr "%1$d س %2$d د"

msgid "%1$s dépensés pour %2$d recette(s), soit %3$s par jour en moyenne. Chaque somme compte le jour où elle a été dépensée."
msgstr "أُنفق %1$s على %2$d وصفة، أي %3$s يوميًا في المتوسط. يُحتسب كل مبلغ في اليوم الذي أُنفق فيه."

