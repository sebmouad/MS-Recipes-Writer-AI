msgstr "المقال مجدول؛ سيظهر في التاريخ المختار."

msgid "L’article est à la corbeille."
msgstr "المقال في سلة المهملات."

msgid "L’article a été supprimé de WordPress."
msgstr "حُذف المقال من ووردبريس."

